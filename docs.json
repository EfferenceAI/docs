{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Efference",
  "colors": {
    "primary": "#808080",
    "light": "#E5E5E5",
    "dark": "#1A1A1A"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "css": "style.css",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://docs.efference.ai"
  },
  "favicon": {
    "light": "/favicon.png",
    "dark": "/favicon.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://efference.ai"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/EfferenceAI/efference"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "get-started/system-overview",
              "get-started/requirements",
              "get-started/installation",
              "get-started/install-jetson",
              "get-started/quickstart-wired",
              "get-started/quickstart-wireless"
            ]
          },
          {
            "group": "Device",
            "pages": [
              "device/overview",
              "device/connection",
              "video/capture",
              "sensors/imu",
              "device/calibration",
              "recording/overview",
              "recording/replay",
              "device/health",
              "device/wifi",
              "device/update",
              "device/management"
            ]
          },
          {
            "group": "Command-Line Tools",
            "pages": [
              "tools/ef",
              "tools/efference-viewer"
            ]
          }
        ]
      },
      {
        "tab": "Tutorials",
        "groups": [
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/connect",
              "tutorials/health-check",
              "tutorials/capture",
              "tutorials/wifi",
              "tutorials/record"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api/device",
              "api/parameters",
              "api/types",
              "api/enums"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/EfferenceAI/efference",
      "x": "https://x.com/efferenceai"
    }
  },
  "fonts": {
    "family": "Inter"
  }
}

