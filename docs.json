{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Efference",
  "colors": {
    "primary": "#808080",
    "light": "#E5E5E5",
    "dark": "#1A1A1A"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "css": "style.css",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://efference.ai"
  },
  "favicon": {
    "light": "/favicon.png",
    "dark": "/favicon.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://efference.ai"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/efferenceai"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "get-started/installation",
              "get-started/quickstart-wired",
              "get-started/quickstart-wireless"
            ]
          },
          {
            "group": "Modules",
            "pages": [
              "video/capture",
              "sensors/imu",
              "recording/overview",
              "recording/replay",
              "device/health",
              "device/wifi",
              "device/update",
              "device/management"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/opencv",
              "integrations/ble"
            ]
          },
          {
            "group": "Command-Line Tools",
            "pages": [
              "tools/ef",
              "tools/ef-grab",
              "tools/efference-viewer"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "tutorials/hello-device",
              "tutorials/health-check",
              "tutorials/image-capture",
              "tutorials/sensor-data",
              "tutorials/recording"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api/device",
              "api/parameters",
              "api/types",
              "api/enums"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/efferenceai",
      "x": "https://x.com/efferenceai"
    }
  },
  "fonts": {
    "family": "Inter"
  }
}

